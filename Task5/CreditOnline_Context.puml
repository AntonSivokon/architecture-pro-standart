@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
title Подача кредитной заявки онлайн
left to right direction

Person(client, "Клиент банка", "Подаёт заявку на сайте или в интернет-банке")
Person(frontManager, "Менеджер отделения", "Идентифицирует клиента и помогает продолжить заявку")
Person(creditManager, "Менеджер кредитования", "Рассматривает заявку и принимает решение")

System_Boundary(bank, "Системы банка") {
    System(website, "Сайт банка", "Предложение кредита и онлайн-заявка нового клиента")
    System(internetBank, "Интернет-банк", "Предодобренные предложения и подтверждённая заявка действующего клиента")
    System(creditPipeline, "Кредитный конвейер", "Принимает онлайн-заявки через REST API, управляет процессом Camunda и передаёт заявку менеджеру")
    System(scoring, "Система кредитного скоринга", "Оценивает заявку и при необходимости запрашивает кредитную историю")
    System(abs, "АБС", "Хранит банковские данные и отражает операции по кредиту; продолжает пакетный обмен с конвейером")
    System(smsGateway, "СМС-шлюз", "Отправляет коды подтверждения и сообщения об изменении статуса")
}

System_Ext(creditHistory, "Бюро кредитных историй", "Предоставляет кредитную историю по REST API")
System_Ext(telecom, "Телеком-оператор", "Доставляет СМС")

Rel_U(client, website, "Подаёт заявку и получает предварительный результат")
Rel(client, internetBank, "Выбирает предложение и отправляет заявку с подтверждением по СМС")
Rel(website, creditPipeline, "Получает условия и отправляет заявку по защищённому REST API")
Rel(internetBank, creditPipeline, "Получает условия/предложения и отправляет подтверждённую заявку")
Rel(creditPipeline, website, "Возвращает идентификатор, предварительный результат или текущий статус")
Rel(creditPipeline, internetBank, "Возвращает предложения, идентификатор и статус заявки")
Rel(creditPipeline, scoring, "Запрашивает оценку по конкретной заявке")
Rel(scoring, creditHistory, "Запрашивает кредитную историю онлайн")
Rel(creditHistory, scoring, "Возвращает кредитную историю")
Rel(scoring, creditPipeline, "Возвращает результат оценки")
Rel(creditManager, creditPipeline, "Рассматривает заявку и фиксирует решение")
Rel(frontManager, creditPipeline, "Находит существующую онлайн-заявку и продолжает процесс")
Rel(frontManager, abs, "Идентифицирует клиента и оформляет необходимые банковские операции")
Rel(creditPipeline, abs, "Сверяет и передаёт результаты через существующий пакетный обмен")
Rel(abs, creditPipeline, "Передаёт заявки отделений и банковские данные пакетно")
Rel(creditPipeline, smsGateway, "Инициирует статусные уведомления")
Rel(internetBank, smsGateway, "Запрашивает СМС-подтверждение подачи заявки")
Rel(smsGateway, telecom, "Передаёт сообщения на доставку")
Rel(telecom, client, "Доставляет коды и уведомления")

@enduml