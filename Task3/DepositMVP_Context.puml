@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
title Диаграмма контекста для открытия депозитов онлайн (MVP)
left to right direction

Person(client, "Клиент", "Клиент или потенциальный клиент банка")
Person(frontManager, "Менеджер отделения", "Идентифицирует нового клиента")
Person(backManager, "Менеджер бэк-офиса", "Согласует условия и открывает депозит")

System_Boundary(bank, "Системы банка") {
    System(site, "Сайт", "Показывает депозитные продукты и принимает лиды")
    System(internetBank, "Интернет-банк", "Подача заявки, подтверждение по СМС и отслеживание статуса")
    System(depositService, "Сервис заявок на депозиты", "Предоставляет ставки, принимает заявки, хранит статусы и обеспечивает повторную доставку")
    System(abs, "АБС", "Хранит банковские данные, ставки и выполняет обработку депозитов")
    System(callCenter, "Система кол-центра", "CRM и обработка обратных звонков")
    System(smsGateway, "СМС-шлюз", "Интеграция для отправки кодов подтверждения и уведомлений")
}

System_Ext(telecomOperator, "Телеком-оператор", "Доставляет СМС")

Rel(client, site, "Просматривает предложения и оставляет лид")
Rel(site, depositService, "Запрашивает каталог депозитов и актуальные ставки")
Rel(site, callCenter, "Передаёт данные лида для обратного звонка")
Rel(callCenter, client, "Звонит и обсуждает условия")

Rel(client, internetBank, "Выбирает депозит, подаёт заявку и смотрит её статус")
Rel(internetBank, depositService, "Запрашивает ставки, передаёт заявку и запрашивает статус")
Rel(internetBank, smsGateway, "Запрашивает отправку кода подтверждения")
Rel(depositService, abs, "Передаёт заявку на обработку и запрашивает актуальные ставки")
Rel(abs, depositService, "Возвращает результаты согласования и открытия депозита")
Rel(depositService, smsGateway, "Отправляет уведомления после согласования ставки и открытия")
Rel(smsGateway, telecomOperator, "Передаёт СМС на доставку")
Rel_L(telecomOperator, client, "Доставляет код подтверждения и уведомления")

Rel(client, frontManager, "После обращения с сайта лично проходит идентификацию перед открытием")
Rel(frontManager, abs, "Фиксирует результат идентификации")
Rel_U(backManager, abs, "Ведёт ставки, согласует условия и инициирует открытие депозита")

@enduml